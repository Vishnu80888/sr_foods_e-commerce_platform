# ── SR Foods Backend Environment Variables ──
PORT=5000
NODE_ENV=production

# MongoDB Connection String (MongoDB Atlas for production, or local for dev)
# Example Atlas: mongodb+srv://<dbuser>:<dbpassword>@cluster0.mongodb.net/srfoods?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<dbuser>:<dbpassword>@cluster0.mongodb.net/srfoods?retryWrites=true&w=majority

# Cryptographically secure secret for JWT tokens (minimum 32 characters)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_at_least_32_chars

# Allowed Frontend Origins (comma-separated if multiple, e.g. https://srfoods.in,https://sr-foods.vercel.app)
CLIENT_URL=*

# Administrator credentials (auto-seeded on first launch if users collection is empty)
ADMIN_NAME=SR Foods Admin
ADMIN_EMAIL=admin@srfoods.com
ADMIN_PASSWORD=Vishnu@SR_Foods
ADMIN_PHONE=+919876543210
